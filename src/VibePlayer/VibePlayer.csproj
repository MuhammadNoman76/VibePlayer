<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VibePlayer</AssemblyName>
    <RootNamespace>VibePlayer</RootNamespace>
    <ApplicationIcon>Assets\VibePlayer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.0.0</Version>
    <Product>VibePlayer</Product>
    <Company>VibePlayer</Company>
    <Description>VibePlayer - a VLC-powered media player with a YouTube-style interface</Description>
    <Copyright>Copyright © 2026</Copyright>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Only ship the 64-bit VLC engine -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VibePlayer.ico" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
